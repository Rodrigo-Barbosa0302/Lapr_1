<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Idosos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Idosos"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <ShellContent Route="Inicio" ContentTemplate="{DataTemplate local:MainPage}" />
    <ShellContent Route="Tutoriais" ContentTemplate="{DataTemplate local:TutoriaisPage}" />
    <ShellContent Route="Suporte" ContentTemplate="{DataTemplate local:SuportePage}" />
    <ShellContent Route="Definicoes" ContentTemplate="{DataTemplate local:DefinicoesPage}" />

</Shell>