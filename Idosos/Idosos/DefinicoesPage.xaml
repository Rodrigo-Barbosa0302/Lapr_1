<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Idosos.Controls"
             x:Class="Idosos.DefinicoesPage"
             BackgroundColor="{StaticResource Fundo}">

    <Grid RowDefinitions="Auto,*">

        <controls:TopBar Grid.Row="0" Active="Definicoes" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,24" Spacing="16">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Definições" Style="{StaticResource TituloPagina}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Ajuste a app ao seu gosto." Style="{StaticResource SubtituloPagina}" />
                </VerticalStackLayout>

                <!-- Tamanho das letras -->
                <Border Style="{StaticResource CartaoStyle}" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tamanho das letras" Style="{StaticResource CartaoTitulo}" />
                            <Label Text="Escolha o que lê melhor." Style="{StaticResource CartaoSub}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button x:Name="BtnNormal" Grid.Column="0" Text="Normal"
                                    Style="{StaticResource BotaoSecundario}"
                                    TextColor="{StaticResource Texto}"
                                    HeightRequest="52" Clicked="OnNormal" />
                            <Button x:Name="BtnGrande" Grid.Column="1" Text="Grande ✓"
                                    Style="{StaticResource BotaoPrimario}" Clicked="OnGrande" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Ler em voz alta -->
                <Border Style="{StaticResource CartaoStyle}" Padding="18">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="🗣️" FontSize="24" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Ler em voz alta" Style="{StaticResource CartaoTitulo}" />
                            <Label Text="Ouvir as instruções da app." Style="{StaticResource CartaoSub}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                            <Switch x:Name="SwVoz" OnColor="{StaticResource Primaria}"
                                    HorizontalOptions="Center" Toggled="OnVozToggled" />
                            <Label x:Name="LblVoz" Text="Desligado" FontSize="13"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Som dos vídeos -->
                <Border Style="{StaticResource CartaoStyle}" Padding="18">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="🔊" FontSize="24" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Som dos vídeos" Style="{StaticResource CartaoTitulo}" />
                            <Label Text="Ouvir o som ao ver um vídeo." Style="{StaticResource CartaoSub}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                            <Switch x:Name="SwSom" OnColor="{StaticResource Primaria}"
                                    HorizontalOptions="Center" Toggled="OnSomToggled" />
                            <Label x:Name="LblSom" Text="Ligado" FontSize="13"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <HorizontalStackLayout Spacing="10" Margin="4,8,0,0">
                    <Label Text="✓" FontSize="18" TextColor="{StaticResource Primaria}" VerticalOptions="Center" />
                    <Label Text="As suas escolhas ficam guardadas automaticamente."
                           FontSize="15" TextColor="{StaticResource TextoSuave}" VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>