<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Idosos.Controls"
             x:Class="Idosos.SuportePage"
             BackgroundColor="{StaticResource Fundo}">

    <Grid RowDefinitions="Auto,*">

        <controls:TopBar Grid.Row="0" Active="Suporte" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,24" Spacing="16">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Suporte" Style="{StaticResource TituloPagina}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Estamos aqui para ajudar, com calma."
                           Style="{StaticResource SubtituloPagina}" />
                </VerticalStackLayout>

                <Border BackgroundColor="{StaticResource PrimariaClara}"
                        Stroke="{StaticResource Borda}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 18" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="🎧" FontSize="22" VerticalOptions="Center" />
                            <Label Text="Precisa de uma mão?" FontSize="19" FontAttributes="Bold"
                                   TextColor="{StaticResource Texto}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="Envie-nos uma mensagem a explicar a sua dúvida."
                               FontSize="16" TextColor="{StaticResource TextoSuave}" />
                        <Button Text="Escrever mensagem  →" Style="{StaticResource BotaoPrimario}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CartaoStyle}" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="▶️" FontSize="22" VerticalOptions="Center" />
                            <Label Text="Aprender passo a passo" FontSize="19" FontAttributes="Bold"
                                   TextColor="{StaticResource Texto}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="Veja vídeos e guias simples. Pode repetir as vezes que quiser."
                               FontSize="16" TextColor="{StaticResource TextoSuave}" />
                        <Button Text="Ver tutoriais  →" Style="{StaticResource BotaoSecundario}"
                                Clicked="OnVerTutoriais" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="6" Margin="0,10,0,0">
                    <Label Text="Não precisa de fazer tudo só." FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource Texto}" />
                    <Label Text="Se preferir, peça a alguém de confiança para ver estes passos consigo."
                           FontSize="16" TextColor="{StaticResource TextoSuave}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>