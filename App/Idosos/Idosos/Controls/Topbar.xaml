<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Idosos.Controls.TopBar">

    <VerticalStackLayout BackgroundColor="White" Spacing="0">

        <HorizontalStackLayout Padding="16,16,16,8" Spacing="12">
            <Border BackgroundColor="{StaticResource Primaria}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    WidthRequest="40" HeightRequest="40">
                <Label Text="👣" FontSize="20"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="Passo a passo"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource Texto}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" Padding="8,0">

            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Inicio" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="🏠" FontSize="20" HorizontalOptions="Center" />
                <Label x:Name="LblInicio" Text="Início" Style="{StaticResource TabLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Tutoriais" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="▶️" FontSize="20" HorizontalOptions="Center" />
                <Label x:Name="LblTutoriais" Text="Tutoriais" Style="{StaticResource TabLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="2">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Suporte" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="🎧" FontSize="20" HorizontalOptions="Center" />
                <Label x:Name="LblSuporte" Text="Suporte" Style="{StaticResource TabLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" Spacing="2">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Definicoes" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="⚙️" FontSize="20" HorizontalOptions="Center" />
                <Label x:Name="LblDefinicoes" Text="Definições" Style="{StaticResource TabLabel}" />
            </VerticalStackLayout>

            <BoxView x:Name="BarInicio" Grid.Row="1" Grid.Column="0"
                     Color="{StaticResource Primaria}" HeightRequest="3" Margin="0,8,0,0" />
            <BoxView x:Name="BarTutoriais" Grid.Row="1" Grid.Column="1"
                     Color="{StaticResource Primaria}" HeightRequest="3" Margin="0,8,0,0" />
            <BoxView x:Name="BarSuporte" Grid.Row="1" Grid.Column="2"
                     Color="{StaticResource Primaria}" HeightRequest="3" Margin="0,8,0,0" />
            <BoxView x:Name="BarDefinicoes" Grid.Row="1" Grid.Column="3"
                     Color="{StaticResource Primaria}" HeightRequest="3" Margin="0,8,0,0" />
        </Grid>

        <BoxView Color="{StaticResource Borda}" HeightRequest="1" />
    </VerticalStackLayout>
</ContentView>