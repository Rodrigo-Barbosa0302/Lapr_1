<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Idosos.Controls"
             x:Class="Idosos.MainPage"
             BackgroundColor="{StaticResource Fundo}">

    <Grid RowDefinitions="Auto,*">

        <controls:TopBar Grid.Row="0" Active="Inicio" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,24" Spacing="14">

                <VerticalStackLayout Spacing="6" Margin="0,0,0,6">
                    <Label Text="Olá! Vamos a isso?" Style="{StaticResource TituloPagina}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Escolha o que quer fazer no telemóvel."
                           Style="{StaticResource SubtituloPagina}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="12" RowSpacing="12">

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CartaoStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="👤" FontSize="24" Margin="0,0,0,10" />
                            <Label Text="Contactos" Style="{StaticResource CartaoTitulo}" />
                            <Label Text="Ligar a alguém" Style="{StaticResource CartaoSub}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CartaoStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📷" FontSize="24" Margin="0,0,0,10" />
                            <Label Text="Câmara" Style="{StaticResource CartaoTitulo}" />
                            <Label Text="Tirar uma fotografia" Style="{StaticResource CartaoSub}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CartaoStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📅" FontSize="24" Margin="0,0,0,10" />
                            <Label Text="Agenda" Style="{StaticResource CartaoTitulo}" />
                            <Label Text="Ver compromissos" Style="{StaticResource CartaoSub}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CartaoStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💬" FontSize="24" Margin="0,0,0,10" />
                            <Label Text="Mensagens" Style="{StaticResource CartaoTitulo}" />
                            <Label Text="Ler e enviar" Style="{StaticResource CartaoSub}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CartaoStyle}" Padding="16,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0" Text="🌐" FontSize="24" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Internet" Style="{StaticResource CartaoTitulo}" />
                            <Label Text="Pesquisar na internet" Style="{StaticResource CartaoSub}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="26"
                               TextColor="{StaticResource TextoSuave}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                    <Label Grid.Column="0" Text="Aprender com calma" Style="{StaticResource SecaoTitulo}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Grid.Column="1" Text="Ver todos ›" FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource Primaria}" VerticalOptions="Center" />
                </Grid>

                <Border Style="{StaticResource CartaoStyle}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid HeightRequest="150" BackgroundColor="#D9DED9">
                            <Border BackgroundColor="#F2FFFFFF" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 28"
                                    WidthRequest="56" HeightRequest="56"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="▶" FontSize="22" TextColor="{StaticResource Texto}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border BackgroundColor="#CC1B2B30" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" Padding="10,4"
                                    HorizontalOptions="End" VerticalOptions="End"
                                    Margin="0,0,12,12">
                                <Label Text="2 min" TextColor="White" FontSize="13" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <VerticalStackLayout Padding="14,14,14,16" Spacing="4">
                            <Label Text="Como tirar uma fotografia" Style="{StaticResource CartaoTitulo}" />
                            <Label Text="Veja o vídeo, passo a passo." Style="{StaticResource CartaoSub}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource PrimariaClara}"
                        Stroke="{StaticResource Borda}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 18" Padding="16" Margin="0,6,0,0">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="🎧" FontSize="20" VerticalOptions="Center" />
                                <Label Text="Precisa de uma mão?" FontSize="18" FontAttributes="Bold"
                                       TextColor="{StaticResource Texto}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Estamos aqui para ajudar." FontSize="15"
                                   TextColor="{StaticResource TextoSuave}" Margin="30,0,0,0" />
                        </VerticalStackLayout>
                        <Button Text="Pedir ajuda  →" Style="{StaticResource BotaoPrimario}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>